# Supabase (local dev: copy from `supabase status` after `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# JWT secret used to sign/verify Supabase tokens
# Local default: super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Slugger auth
# Origins allowed to send SLUGGER_AUTH messages (alpb-analytics.com is always included in code)
# SLUGGER_STAGING_ORIGIN=https://staging.alpb-analytics.com

# Cognito fallback (Path 3) — optional; skip if not using Cognito
# COGNITO_REGION=us-east-1
# COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# OpenRouter API (onboarding chat — get a free key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your-openrouter-api-key

# Data migration (Stage 8) — point at the OLD Supabase project (read-only source)
# Only needed when running scripts/migrate-all.ts or individual migrate-*.ts scripts.
# These are NEVER used by the app at runtime.
# OLD_SUPABASE_URL=https://your-old-project.supabase.co
# OLD_SUPABASE_SERVICE_ROLE_KEY=your-old-service-role-key

# Dev mode — set to "true" to bypass Slugger postMessage auth
# NEXT_PUBLIC_DEV_MODE=true
# NEXT_PUBLIC_DEV_USER_ROLE=league      # league | gm | player (Slugger roles)
# NEXT_PUBLIC_DEV_USER_TEAM=1
# NEXT_PUBLIC_DEV_USER_ID=1
